# LLM API Configuration
# Supply at least one valid key below (Groq Cloud or Google AI Studio Gemini recommended for $0 cost)

# 1. Zero-Cost Groq Cloud API (Recommended: Free tier, 300+ tok/s)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# 2. Zero-Cost Google AI Studio Gemini API (1M token context window)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# 3. Optional: Paid Providers (OpenAI, Anthropic)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 4. Optional: Local Ollama Host
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama2
